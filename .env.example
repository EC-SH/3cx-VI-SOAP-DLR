# VoIP Innovations API user (backoffice.voipinnovations.com > API Users)
VI_LOGIN=your_vi_api_login
VI_PASSWORD=your_vi_api_password

# Inbound webhook URL from the 3CX SMS provider tab
THREECX_WEBHOOK_URL=https://your-pbx.example.3cx.us/sms/generic/xxxxxxxx

# Shared secret required on /inbound, /outbound and /dlr. Strongly recommended
# when deployed with --allow-unauthenticated. Callers present it as
#   X-Auth-Token: <secret>         (custom header on the 3CX generic provider)
#   Authorization: Bearer <secret>
#   X-Webhook-Secret: <secret>
#   ?secret=<secret> on the URL    (VI DID destination / Sangoma webhook)
# Leave blank to accept unauthenticated requests (a warning is logged at boot).
WEBHOOK_SECRET=

# This service's own public URL — optional, only used to print the URLs you
# need to configure at 3CX and VI when the service boots
OUTBOUND_URL=https://threecx-sms-outbound-dlr-xxxx.a.run.app

# Set automatically by Cloud Run; only needed for local dev
# PORT=8080
